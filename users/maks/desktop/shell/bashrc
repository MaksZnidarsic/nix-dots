


export VIRTUAL_ENV_DISABLE_PROMPT=1

function venv_prompt() {
    prompt=""
    if [[ -n "$VIRTUAL_ENV" ]]; then
        prompt=" ${VIRTUAL_ENV##*/}"
    fi
    echo "$prompt"
}

export PS1='\[\e[1;33m\]$(venv_prompt) \[\e[1;36m\]\w\[\e[m\] '

# to show current working directory in terminal name
export PROMPT_COMMAND='echo -ne "\033]2;$(basename "$(cat "/proc/$PPID/comm")") $PWD\007"'

tput cup $LINES 0
