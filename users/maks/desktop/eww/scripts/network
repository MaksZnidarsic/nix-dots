#!/usr/bin/env bash


function name() {
    echo $(nmcli | grep '^wl' | sed 's/\ connected to\ //' | cut -d ':' -f2)
}


function state() {
    cat /sys/class/net/w*/operstate
}


function strength() {
    nmcli -f IN-USE,SIGNAL,SSID device wifi | awk '/^\*/{if (NR!=1) {print $2}}'
}


echo \{\"name\":\"$(name)\",\"state\":\"$(state)\",\"strength\":\"$(strength)\"\}
